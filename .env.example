# Auto-generated by scripts/generate-env.sh
# DO NOT edit manually — run ./install.sh or ./reinstall.sh to regenerate

# WARP SOCKS5 proxy (shared network namespace with warp-proxy container)
HTTP_PROXY=http://127.0.0.1:9091
HTTPS_PROXY=http://127.0.0.1:9091
ALL_PROXY=http://127.0.0.1:9091

# Node.js TLS Anti-Fingerprint (randomly permuted cipher suite order)
# Changes the JA3/JA4 TLS ClientHello fingerprint on every reinstall
NODE_OPTIONS=--tls-cipher-list=ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-CHACHA20-POLY1305:...

# Node.js Client Identity (authentic Node.js HTTP library — no browser emulation)
# Randomly selected from a pool of real Node.js client User-Agents
USER_AGENT=axios/1.7.7 (Node.js/v20.17.0; linux-x64)

# Unique machine identifier (regenerated on reinstall)
MACHINE_ID=<random-hex-32>

# Cloudflare WARP Endpoint (rotated on reinstall)
WARP_SERVER=162.159.192.1
WARP_PORT=2408

